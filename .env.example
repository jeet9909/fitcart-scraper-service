OPENAI_API_KEY=replace_me
BRIGHTDATA_API_TOKEN=replace_me
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=replace_me
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=fitcart-tryons
ANONYMOUS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
SCRAPE_TIMEOUT_SECONDS=60
MAX_CONCURRENT_SCRAPES=5
# Optional comma-separated domain allowlist. Leave empty to accept any public URL.
ALLOWED_PRODUCT_HOSTS=
# Bright Data Web Unlocker zone used to fetch raw product HTML for images.
# The hosted MCP creates "mcp_unlocker"; it is always tried as a fallback.
BRIGHTDATA_ZONE=mcp_unlocker
# Comma-separated emails that get unlimited looks after signing in with an email code.
UNLIMITED_EMAILS=
# Server-side look limits (needs the look_grants table and functions from supabase/schema.sql).
LOOK_LIMITS_ENABLED=true
FREE_LOOKS_PER_MONTH=3
# Razorpay (payments). Use test keys (rzp_test_...); live keys are refused unless RAZORPAY_ALLOW_LIVE=true.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ALLOW_LIVE=false
# Blend the real face back onto generated try-ons and send a face close-up as identity reference.
FACE_LOCK_ENABLED=true
# Our own sign-in codes, emailed from your Gmail through the Gmail API (HTTPS; works on Render's free plan).
# Leave empty to let Supabase Auth send the codes instead.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_SENDER=
EMAIL_SENDER_NAME=FitCart
# Or plain SMTP on hosts that allow it:
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
