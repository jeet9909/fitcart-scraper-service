OPENAI_API_KEY=replace_me
BRIGHTDATA_API_TOKEN=replace_me
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=replace_me
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=fitcart-tryons
ANONYMOUS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
SCRAPE_TIMEOUT_SECONDS=60
MAX_CONCURRENT_SCRAPES=5
# Optional comma-separated domain allowlist. Leave empty to accept any public URL.
ALLOWED_PRODUCT_HOSTS=
# Bright Data Web Unlocker zone used to fetch raw product HTML for images.
# The hosted MCP creates "mcp_unlocker"; it is always tried as a fallback.
BRIGHTDATA_ZONE=mcp_unlocker
# Comma-separated emails that get unlimited looks after signing in with an email code.
UNLIMITED_EMAILS=
# Server-side look limits (needs the look_grants table and functions from supabase/schema.sql).
LOOK_LIMITS_ENABLED=true
FREE_LOOKS_PER_MONTH=3
# Stripe Checkout. Use test keys (sk_test_...); live keys are refused unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false
# Where Stripe sends buyers back after checkout.
APP_URL=https://jeet9909.github.io/fitcart-scraper-service/
